# =============================================================================
# RechercheMedical — modèle de configuration
# Copier ce fichier vers .env et renseigner les valeurs
# =============================================================================

DJANGO_ENV=local
DEBUG=True
SECRET_KEY=changez-moi

ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SQLite local (laisser vide) ou PostgreSQL production :
# DATABASE_URL=postgres://user:password@host:5432/recherche_medical

GOOGLE_CLIENT_ID=votre-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

EMAIL_USE_SMTP=false
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application
DEFAULT_FROM_EMAIL=votre@gmail.com

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

USE_REDIS=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

LOG_LEVEL=DEBUG
