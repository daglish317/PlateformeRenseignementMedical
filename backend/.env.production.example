# =============================================================================
# RechercheMedical — PRODUCTION
# Renommer en .env sur le serveur ou exporter ces variables d'environnement
# =============================================================================

DJANGO_ENV=production
DEBUG=False
SECRET_KEY=GENERER-UNE-CLE-FORTE-UNIQUE

ALLOWED_HOSTS=votre-domaine.com,www.votre-domaine.com
CSRF_TRUSTED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com
CORS_ALLOWED_ORIGINS=https://votre-domaine.com,https://www.votre-domaine.com

DATABASE_URL=postgres://user:password@host:5432/recherche_medical

GOOGLE_CLIENT_ID=votre-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-votre-client-secret

EMAIL_USE_SMTP=true
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre@gmail.com
EMAIL_HOST_PASSWORD=mot-de-passe-application
DEFAULT_FROM_EMAIL=votre@gmail.com

WEB_PUSH_VAPID_PUBLIC_KEY=cle-publique-vapid
WEB_PUSH_VAPID_PRIVATE_KEY=cle-privee-vapid
WEB_PUSH_VAPID_SUBJECT=mailto:support@votre-domaine.com

JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

USE_REDIS=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379/0

SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
LOG_LEVEL=INFO
